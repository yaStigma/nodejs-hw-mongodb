  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "contactType",
          "userId"
        ],
        "properties": {
          "_id": {
            "description": "Contact's id",
            "type": "string",
            "example": "67455ef528989ed3d292c0bc"
          },
          "name": {
            "description": "Contact's name",
            "type": "string",
            "example": "Eren Yeager"
          },
          "phoneNumber": {
            "description": "Contact's number",
            "type": "string",
            "example": "+38 067 158 487"
          },
          "email": {
            "description": "Contact's email",
            "type": "string",
            "example": "titan2024@mail.com"
          },
          "isFavourite": {
            "description": "Whether the contact is a favorite",
            "type": "boolean",
            "example": false
          },
          "contactType": {
            "description": "What type of number does this contact have? personal, work or home",
            "type": "string",
            "enum": [
              "work",
              "home",
              "personal"
            ]
          },
          "userId": {
            "description": "ID of the user who created the contact",
            "type": "string",
            "example": "67455c06430ed6efbe951e19"
          },
          "photo": {
            "description": "Link to contact's photo",
            "type": "string",
            "example": "https://res.cloudinary.com/dphrnfofc/image/upload/v1733083953/yorysreoulq32z4dsck4.jpg"
          }
        }
      },
      "auth": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "email",
          "password"
        ],
        "properties": {
          "_id": {
            "description": "User's id",
            "type": "string",
            "example": "67455c06430ed6efbe951e19"
          },
          "name": {
